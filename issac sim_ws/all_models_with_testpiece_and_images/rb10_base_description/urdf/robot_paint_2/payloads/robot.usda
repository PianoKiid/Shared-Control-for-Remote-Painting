#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "rb10_base_description"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "rb10_base_description" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </rb10_base_description/Physics/base>,
        </rb10_base_description/Physics/support_to_rb10>,
        </rb10_base_description/Physics/shoulder>,
        </rb10_base_description/Physics/elbow>,
        </rb10_base_description/Physics/wrist1>,
        </rb10_base_description/Physics/wrist2>,
        </rb10_base_description/Physics/wrist3>,
        </rb10_base_description/Physics/support_table_fixed>,
        </rb10_base_description/Physics/support_mount_plate_fixed>,
        </rb10_base_description/Physics/single_roller_aft200_fixed_joint>,
        </rb10_base_description/Physics/single_roller_aft200_cable_guard_fixed_joint>,
        </rb10_base_description/Physics/single_roller_paint_eoat_no_camera_fixed_joint>,
        </rb10_base_description/Physics/single_roller_paint_eoat_no_camera_roller_contact_fixed_joint>,
        </rb10_base_description/Physics/single_roller_paint_d405_link_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </rb10_base_description/Geometry/support_world/link0>,
        </rb10_base_description/Geometry/support_world/link0/link1>,
        </rb10_base_description/Geometry/support_world/link0/link1/link2>,
        </rb10_base_description/Geometry/support_world/link0/link1/link2/link3>,
        </rb10_base_description/Geometry/support_world/link0/link1/link2/link3/link4>,
        </rb10_base_description/Geometry/support_world/link0/link1/link2/link3/link4/link5>,
        </rb10_base_description/Geometry/support_world/link0/link1/link2/link3/link4/link5/link6>,
        </rb10_base_description/Geometry/support_world/support_table>,
        </rb10_base_description/Geometry/support_world/support_mount_plate>,
        </rb10_base_description/Geometry/support_world/link0/link1/link2/link3/link4/link5/link6/single_roller_ft_link/tcp/single_roller_aft200_link>,
        </rb10_base_description/Geometry/support_world/link0/link1/link2/link3/link4/link5/link6/single_roller_ft_link/tcp/single_roller_aft200_link/single_roller_aft200_cable_guard_link>,
        </rb10_base_description/Geometry/support_world/link0/link1/link2/link3/link4/link5/link6/single_roller_ft_link/tcp/single_roller_paint_eoat_no_camera_link>,
        </rb10_base_description/Geometry/support_world/link0/link1/link2/link3/link4/link5/link6/single_roller_ft_link/tcp/single_roller_paint_eoat_no_camera_link/single_roller_paint_eoat_no_camera_roller_contact_link>,
        </rb10_base_description/Geometry/support_world/link0/link1/link2/link3/link4/link5/link6/single_roller_ft_link/tcp/single_roller_paint_eoat_no_camera_link/single_roller_paint_d405_bottom_screw_frame/single_roller_paint_d405_link>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "support_world"
        {
            over "link0" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "link1" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "link2" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "link3" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "link4" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "link5" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                    over "link6" (
                                        prepend apiSchemas = ["IsaacLinkAPI"]
                                    )
                                    {
                                        over "single_roller_ft_link"
                                        {
                                            over "tcp"
                                            {
                                                over "single_roller_aft200_link" (
                                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                                )
                                                {
                                                    over "single_roller_aft200_cable_guard_link" (
                                                        prepend apiSchemas = ["IsaacLinkAPI"]
                                                    )
                                                    {
                                                    }
                                                }

                                                over "single_roller_paint_eoat_no_camera_link" (
                                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                                )
                                                {
                                                    over "single_roller_paint_d405_bottom_screw_frame"
                                                    {
                                                        over "single_roller_paint_d405_link" (
                                                            prepend apiSchemas = ["IsaacLinkAPI"]
                                                        )
                                                        {
                                                        }
                                                    }

                                                    over "single_roller_paint_eoat_no_camera_roller_contact_link" (
                                                        prepend apiSchemas = ["IsaacLinkAPI"]
                                                    )
                                                    {
                                                    }
                                                }
                                            }
                                        }

                                        over "single_roller_arm_flange" (
                                            prepend apiSchemas = ["IsaacSiteAPI"]
                                        )
                                        {
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            over "support_table" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "support_mount_plate" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }
        }
    }

    over "Physics"
    {
        over "base" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "shoulder" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "elbow" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wrist1" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wrist2" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wrist3" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "single_roller_aft200_fixed_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "single_roller_aft200_cable_guard_fixed_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "single_roller_paint_eoat_no_camera_fixed_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "single_roller_paint_eoat_no_camera_roller_contact_fixed_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "single_roller_paint_d405_link_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "support_to_rb10" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "support_table_fixed" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "support_mount_plate_fixed" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

