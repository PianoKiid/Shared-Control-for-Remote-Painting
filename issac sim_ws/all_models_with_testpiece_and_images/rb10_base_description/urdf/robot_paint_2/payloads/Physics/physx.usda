#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "rb10_base_description"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "rb10_base_description"
{
    over "Physics"
    {
        over "base" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "shoulder" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "elbow" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "wrist1" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "wrist2" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "wrist3" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }
    }
}

